<?xml version="1.0" encoding="utf-8"?>
<!--
  Murmur only needs to know when a keyboard window is on screen (to place the mic
  button above it) and which text field has focus (to keep the button clear of
  it and to insert the transcript).
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowsChanged|typeWindowStateChanged|typeViewFocused"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRetrieveInteractiveWindows"
    android:canRetrieveWindowContent="true"
    android:description="@string/accessibility_description"
    android:isAccessibilityTool="false"
    android:notificationTimeout="50"
    android:summary="@string/accessibility_summary" />
